# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Database (development database — never production for testing)
# Supabase: pooled connection for the app
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/restaurant_saas_dev"
# Supabase: direct connection, used only by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/restaurant_saas_dev"

# Login tokens — use a long random value, different for every environment
JWT_SECRET="change-me-to-a-long-random-secret"

# Which app addresses may call the API (comma separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"

PORT=4000
